# MAPCO V2 frontend env. Copy to .env and fill in.
# Get values from: supabase dashboard → Project Settings → API (MAPCO-DEV).
VITE_SUPABASE_URL=https://lswzrkvdwirhvggtvuch.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
# Development/tests may use mock. Every production deployment MUST use supabase;
# the app intentionally fails closed instead of creating local-only data.
# mock (development/tests only) | supabase (real MAPCO-DEV data)
VITE_DATA_MODE=mock
